    "Plus cher que les places à l'unité — c'est ce qui finance un projet libre, sans pub et sans mouchard.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلى من شراء المقاعد فرادى — وهو ما يموّل مشروعًا حرًّا بلا إعلانات ولا متعقّبات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dearer than buying slots one by one — that is what funds a free-software project with no ads and no trackers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más caro que comprar plazas de una en una: es lo que financia un proyecto libre, sin anuncios ni rastreadores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比单个购买名额更贵——正是它支撑着这个无广告、无追踪的自由软件项目。"
          }
        }
      }
    },
