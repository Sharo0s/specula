    "Specula interroge désormais tes services. Le mode Démo est désactivé — tu peux le réactiver dans Réglages à tout moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعلم Specula الآن عن خدماتك. تم إيقاف وضع العرض التجريبي — يمكنك تفعيله مجددًا من الإعدادات في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula is now polling your services. Demo mode is off — you can turn it back on in Settings at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula ya consulta tus servicios. El modo Demo está desactivado: puedes reactivarlo en Ajustes cuando quieras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula 现在开始查询你的服务。演示模式已关闭 — 你可以随时在设置中重新开启。"
          }
        }
      }
    },
    "Specula interroge tes services directement chez toi. iOS va te demander l'accès à ton réseau local — sans lui, impossible de scanner ni de contacter tes machines.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعلم Specula عن خدماتك مباشرة من منزلك. سيطلب iOS الوصول إلى شبكتك المحلية — بدونه يتعذّر الفحص أو الاتصال بأجهزتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula polls your services right at home. iOS will ask for local network access — without it, it can't scan or reach your machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula consulta tus servicios directamente en tu casa. iOS te pedirá acceso a la red local: sin él, no puede escanear ni contactar con tus máquinas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula 直接在你家里查询你的服务。iOS 会请求访问本地网络 — 没有它就无法扫描或连接你的机器。"
          }
        }
      }
    },
    "Specula s'ouvre à l'ouverture de session, sans fenêtre.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Specula عند تسجيل الدخول، بلا نافذة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula opens at login, without a window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula se abre al iniciar sesión, sin ventana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Specula 会在登录时启动，且不打开窗口。"
          }
        }
      }
    },
