    "Beaucoup de homelabs (reverse proxy, Docker) n'annoncent pas en Bonjour. Tu peux importer ton services.yaml à la place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كثير من أنظمة Homelab (البروكسي العكسي، Docker) لا تُعلن عبر Bonjour. يمكنك استيراد ملف services.yaml بدلاً من ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many homelabs (reverse proxy, Docker) don't advertise over Bonjour. You can import your services.yaml instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos homelabs (proxy inverso, Docker) no se anuncian por Bonjour. Puedes importar tu services.yaml en su lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很多 homelab（反向代理、Docker）不会通过 Bonjour 广播。你可以改为导入 services.yaml。"
          }
        }
      }
    },
