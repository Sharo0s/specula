    "Avec les clés API": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع مفاتيح API"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With API keys"
          }
        },
        "es": {
          "stringUnit": {
