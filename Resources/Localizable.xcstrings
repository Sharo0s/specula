    "Jellyfin, Proxmox, Home Assistant, AdGuard… tes services selfhosted, leurs métriques en direct et les pannes qui comptent — sur iPhone, iPad et Mac.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Jellyfin، ‏Proxmox، ‏Home Assistant، ‏AdGuard… خدماتك المستضافة ذاتيًا، ومقاييسها المباشرة، والأعطال التي تهمّك — على iPhone وiPad وMac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin, Proxmox, Home Assistant, AdGuard… your self-hosted services, their live metrics and the outages that matter — on iPhone, iPad and Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin, Proxmox, Home Assistant, AdGuard… tus servicios autoalojados, sus métricas en directo y las caídas que importan — en iPhone, iPad y Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin、Proxmox、Home Assistant、AdGuard… 你的自托管服务、实时指标，以及真正要紧的故障 — iPhone、iPad 和 Mac 全都支持。"
          }
        }
      }
    },
