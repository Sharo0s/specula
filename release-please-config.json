{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "specula",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["project.yml"]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Fonctionnalités" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performances" },
    { "type": "refactor", "section": "Refactorisations" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "Intégration continue", "hidden": true },
    { "type": "chore", "section": "Divers", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ]
}
