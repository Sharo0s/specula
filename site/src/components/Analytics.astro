---
/**
 * Mesure d'audience PostHog.
 *
 * Trois choix qui méritent d'être dits, parce qu'ils sont volontaires :
 *
 * 1. **Script empaqueté, pas en ligne.** Astro le sert depuis `/_astro/`, donc
 *    `script-src 'self'` suffit. Un script en ligne aurait exigé un second
 *    hash SHA-256 dans `vercel.json`, à recalculer à chaque retouche — le
 *    genre d'oubli qui ne casse qu'en production.
 * 2. **Appels par le proxy `/ph`** (voir les `rewrites` de `vercel.json`) :
 *    même origine, donc la CSP reste en `'self'` et les bloqueurs de pub ne
 *    coupent pas la mesure.
 * 3. **Tous les capteurs, aucun bandeau.** Choix explicite de Sylvain, le
 *    15 août 2026. À ce niveau de collecte — clics, cartes de chaleur,
 *    enregistrement des sessions — le site sort de l'exemption CNIL de la
 *    mesure d'audience, et le consentement préalable devient légalement
 *    exigible en France. Il n'est pas recueilli. Le seul refus possible reste
 *    `respect_dnt`, gardé pour cette raison.
 *
 *    Y revenir tient en quatre lignes : `autocapture: false`,
 *    `capture_heatmaps: false`, `disable_session_recording: true`,
 *    `disable_surveys: true`.
 *
 * Sans `PUBLIC_POSTHOG_KEY`, rien ne se charge : le site reste exactement ce
 * qu'il était avant, y compris en développement.
 */
const enabled = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY);
---

{
  enabled && (
    <script>
      // La clé passe par `import.meta.env`, que Vite remplace au moment du
      // build, et non par `define:vars` — ce dernier forcerait le script en
      // ligne et donc un second hash à tenir à jour dans la CSP.
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;

      import('posthog-js').then(({ default: posthog }) => {
        posthog.init(key, {
          // Le proxy de même origine, pas le domaine de PostHog.
          api_host: `${location.origin}/ph`,
          // Sert uniquement aux liens « voir dans PostHog » de l'interface.
          ui_host: 'https://eu.posthog.com',
          // Collecte ouverte : chaque clic (`autocapture`), les coordonnées
          // de ces clics (`capture_heatmaps`), le rejeu de la navigation
          // (`session_recording`), les clics morts, les erreurs JavaScript et
          // les temps de chargement.
          autocapture: true,
          capture_heatmaps: true,
          disable_session_recording: false,
          capture_dead_clicks: true,
          capture_exceptions: true,
          capture_performance: true,
          disable_surveys: false,
          capture_pageview: true,

          // L'enregistrement de session rejoue le contenu des pages. Le site
          // n'a ni formulaire ni zone de saisie, mais le masquage reste armé :
          // le jour où il en gagne un, la saisie ne partira pas chez PostHog
          // sans qu'on l'ait décidé.
          session_recording: {
            maskAllInputs: true,
            maskTextSelector: '[data-private]',
            // Le site n'appelle aucune API : les seules requêtes du navigateur
            // sont celles de PostHog lui-même. Enregistrer leur corps
            // reviendrait à stocker les évènements en double, pour rien. Le
            // refus est posé ici en plus du réglage de projet, qui pourrait
            // être rebasculé sans que ce code le sache.
            recordBody: false,
          },

          cookie_expiration: 395,
          cross_subdomain_cookie: false,
          // L'adresse IP sert déjà à déduire le pays côté serveur : la joindre
          // en clair aux évènements n'apporterait aucune analyse de plus.
          property_denylist: ['$ip'],
          // Aucun bandeau n'étant affiché, c'est le seul refus qu'un visiteur
          // puisse exprimer. À garder.
          respect_dnt: true,
          // Le site est multilingue : sans ça, les cinq versions d'une même
          // page se confondent dans les rapports.
          loaded: (ph) => ph.register({ langue: document.documentElement.lang }),
        });
      });
    </script>
  )
}
