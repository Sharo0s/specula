---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * La vitrine défilante : un iPhone épinglé au centre de l'écran pendant que le
 * défilement traverse quatre écrans de la démo — lire, alerter, statut,
 * réglages. Le dock sous le téléphone suit l'état courant et sait y mener.
 *
 * Les captures viennent du mode démo, par langue quand elles existent ; le
 * français sert de repli tant qu'une langue n'a pas les siennes.
 */
const STATES = ['read', 'alert', 'status', 'settings'] as const;
const shotsLang = existsSync(resolve(process.cwd(), 'public/shots', lang, 'demo-read-light.png'))
  ? lang
  : 'fr';
const shot = (state: string, theme: string) => `/shots/${shotsLang}/demo-${state}-${theme}.png`;

const alts: Record<(typeof STATES)[number], string> = {
  read: t('shot.ios.alt'),
  alert: t('journey.alert.alt'),
  status: t('journey.status.alt'),
  settings: t('journey.settings.alt'),
};

const dockLabels: Record<(typeof STATES)[number], string> = {
  read: t('journey.read'),
  alert: t('journey.alert'),
  status: t('journey.status'),
  settings: t('journey.settings'),
};
---

<div
  class="journey"
  id="apercu"
  data-state="read"
  style={STATES.map(
    (s) => `--shot-${s}: url('${shot(s, 'light')}'); --shot-${s}-dark: url('${shot(s, 'dark')}');`
  ).join(' ')}
>
  <div class="journey-sticky">
    <div class="showcase">
      {/* Lire : deux services et leurs métriques, monogrammes colorés comme
          dans l'app quand le logo distant est coupé. */}
      <div class="float-card fc-start fc-state st-read">
        <div class="fc-head">
          <span class="mono-badge" style="background:rgba(104,190,104,.14);color:#3d8b3d">A</span>
          <b>AdGuard Home</b>
        </div>
        <div class="fc-chips"><span>{t('journey.adguard.reqs')}</span><span>{t('journey.adguard.blocked')}</span></div>
      </div>
      <div class="float-card fc-end fc-state st-read">
        <div class="fc-head">
          <span class="mono-badge" style="background:rgba(230,138,60,.14);color:#c2691a">P</span>
          <b>Proxmox VE</b>
        </div>
        <div class="fc-chips"><span>{t('journey.proxmox.nodes')}</span><span>{t('journey.proxmox.cpu')}</span></div>
      </div>
      {/* Alerter : les deux notifications, la panne et le retour. */}
      <div class="float-card fc-start fc-state st-alert">
        <div class="fc-head">
          <img src="/icon-180.png" alt="" width="22" height="22" />
          <b>Specula</b>
          <time>{t('journey.up.time')}</time>
        </div>
        <p class="fc-body"><span class="ok">{t('journey.up.title')}</span> — {t('journey.up.body')}</p>
      </div>
      <div class="float-card fc-end fc-state st-alert">
        <div class="fc-head">
          <img src="/icon-180.png" alt="" width="22" height="22" />
          <b>Specula</b>
          <time>{t('journey.down.time')}</time>
        </div>
        <p class="fc-body"><span class="ko">{t('journey.down.title')}</span> — {t('journey.down.body')}</p>
      </div>
      {/* Statut : cartes repoussées aux extrêmes pour dégager le mur. */}
      <div class="float-card fc-start fc-state st-status">
        <div class="fc-head">
          <span class="fc-label">{t('journey.uptime.title')}</span>
          <span class="fc-up">{t('journey.uptime.value')}</span>
        </div>
        <p class="fc-body">{t('journey.uptime.body')}</p>
      </div>
      <div class="float-card fc-end fc-state st-status">
        <div class="fc-head"><span class="fc-label">{t('journey.incident.title')}</span></div>
        <p class="fc-body"><span class="ko">{t('journey.incident.date')}</span> — {t('journey.incident.body')}</p>
      </div>
      <div class="float-card fc-start fc-state st-settings">
        <div class="fc-head"><span class="fc-label">{t('journey.pinned.title')}</span></div>
        <p class="fc-body">{t('journey.pinned.body')}</p>
      </div>
      <div class="float-card fc-end fc-state st-settings">
        <div class="fc-head"><span class="fc-label">{t('journey.theme.title')}</span></div>
        <p class="fc-body">{t('journey.theme.body')}</p>
      </div>

      <div class="phone">
        {STATES.map((s) => (
          <div class:list={['shot', `shot-${s}`]} role="img" aria-label={alts[s]} />
        ))}
      </div>
    </div>

    <nav class="dock" aria-label={t('journey.status')}>
      {STATES.map((s, i) => (
        <a class:list={['dock-item', { 'is-active': i === 0 }]} data-spy={s} href="#apercu">
          {dockLabels[s]}
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  // La vitrine : le défilement traverse les quatre états, le dock suit et
  // pilote. Sans JavaScript, le premier écran reste affiché — la page se lit.
  const journey = document.getElementById('apercu');
  if (journey) {
    const STATES = ['read', 'alert', 'status', 'settings'];
    const dockItems = Array.from(journey.querySelectorAll<HTMLAnchorElement>('.dock-item'));

    const setState = (s: string) => {
      journey.dataset.state = s;
      dockItems.forEach((i) => i.classList.toggle('is-active', i.dataset.spy === s));
    };

    const onScroll = () => {
      const rect = journey.getBoundingClientRect();
      const total = journey.offsetHeight - innerHeight;
      const progress = Math.min(0.999, Math.max(0, -rect.top / total));
      setState(STATES[Math.floor(progress * STATES.length)]);
    };

    dockItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const idx = STATES.indexOf(item.dataset.spy ?? '');
        const top = journey.getBoundingClientRect().top + scrollY;
        const total = journey.offsetHeight - innerHeight;
        scrollTo({ top: top + (total * (idx + 0.5)) / STATES.length, behavior: 'smooth' });
      });
    });

    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .journey {
    height: 440vh;
    /* La pile téléphone + dock (~790 px) est centrée dans l'écran épinglé :
       on replie les demi-vides du premier et du dernier écran, sinon le héro
       et le marquee s'éloignent d'autant. */
    margin-block-start: min(0px, calc((790px - 100vh) / 2));
    margin-block-end: min(0px, calc((790px - 100vh) / 2));
  }
  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .showcase {
    position: relative;
    width: min(960px, 92vw);
    display: flex;
    justify-content: center;
  }

  /* — l'iPhone : bordure épaisse et coins profonds, comme le vrai châssis.
       Les captures gardent leur propre barre d'état et leur îlot. — */
  .phone {
    position: relative;
    z-index: 2;
    width: min(315px, 80vw);
    border: 11px solid #1c1917;
    border-radius: 54px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(243, 242, 242, 0.08);
  }
  .shot {
    aspect-ratio: 620 / 1348;
    background: var(--shot-read) center / cover no-repeat;
  }
  .shot + .shot {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .shot-alert { background-image: var(--shot-alert); }
  .shot-status { background-image: var(--shot-status); }
  .shot-settings { background-image: var(--shot-settings); }
  .journey[data-state='alert'] .shot-alert,
  .journey[data-state='status'] .shot-status,
  .journey[data-state='settings'] .shot-settings { opacity: 1; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .shot { background-image: var(--shot-read-dark); }
    :root:not([data-theme='light']) .shot-alert { background-image: var(--shot-alert-dark); }
    :root:not([data-theme='light']) .shot-status { background-image: var(--shot-status-dark); }
    :root:not([data-theme='light']) .shot-settings { background-image: var(--shot-settings-dark); }
  }
  :root[data-theme='dark'] .shot { background-image: var(--shot-read-dark); }
  :root[data-theme='dark'] .shot-alert { background-image: var(--shot-alert-dark); }
  :root[data-theme='dark'] .shot-status { background-image: var(--shot-status-dark); }
  :root[data-theme='dark'] .shot-settings { background-image: var(--shot-settings-dark); }

  /* — cartes flottantes : une de chaque côté, propres à chaque état — */
  .float-card {
    position: absolute;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 14px 16px;
    width: 250px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }
  .journey[data-state='read'] .st-read,
  .journey[data-state='alert'] .st-alert,
  .journey[data-state='status'] .st-status,
  .journey[data-state='settings'] .st-settings { opacity: 1; transform: none; }

  .fc-end { top: 9%; inset-inline-end: max(8px, 9%); z-index: 3; }
  .fc-start { top: 58%; inset-inline-start: max(8px, 9%); z-index: 3; }
  /* Statut : le mur occupe tout l'écran, les cartes se rangent aux extrêmes. */
  .st-status.fc-end { top: 4%; inset-inline-end: 0; }
  .st-status.fc-start { top: 78%; inset-inline-start: 0; }

  /* L'en-tête de carte : monogramme ou icône, nom en gras, heure à droite. */
  .fc-head { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .fc-head b { font-weight: 700; }
  .fc-head img { width: 22px; height: 22px; border-radius: 6px; flex: none; }
  .fc-head time {
    margin-inline-start: auto;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    font-size: 12px;
  }
  .mono-badge {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    flex: none;
  }
  .fc-label {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .fc-up {
    margin-inline-start: auto;
    font-weight: 700;
    color: var(--ok);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .fc-body { margin: 6px 0 0; font-size: 13.5px; color: var(--muted); text-wrap: pretty; }
  .fc-body .ko { color: var(--accent); font-weight: 640; }
  .fc-body .ok { color: var(--ok); font-weight: 640; }
  .fc-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-block-start: 10px; }
  .fc-chips span {
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--ok-soft);
    color: var(--ok);
  }

  /* — le dock, à distance fixe sous le téléphone, même verre que la pilule — */
  .dock {
    position: relative;
    z-index: 3;
    margin-block-start: 26px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 76%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
  }
  .dock-item {
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 650;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .dock-item:hover { color: var(--text); }
  .dock-item.is-active { background: var(--accent); color: var(--accent-text); }

  @media (max-width: 880px) {
    .fc-end { inset-inline-end: 0; }
    .fc-start { inset-inline-start: 0; }
  }
  @media (max-width: 600px) {
    .float-card { width: 200px; padding: 11px 13px; }
    .dock-item { padding: 8px 12px; font-size: 12.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot + .shot, .float-card, .dock-item { transition: none; }
  }
</style>
