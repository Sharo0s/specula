---
import { useTranslations, type Locale } from '../i18n';
import { PRICES, formatPrice } from '../data/pricing';
import { STORE_URL, IS_LIVE } from '../data/links';

interface Props {
  lang: Locale;
  /** Lien secondaire discret sous la ligne de prix. */
  secondary?: { href: string; label: string };
}

const { lang, secondary } = Astro.props;
const t = useTranslations(lang);

/**
 * Les badges viennent de `toolbox.marketingtools.apple.com` et ne sont pas
 * retouchés : les Identity Guidelines d'Apple interdisent de les redessiner ou
 * d'en changer les couleurs. Apple ne publie pas de variante arabe — la page
 * arabe reçoit donc l'anglaise.
 */
const BADGE_LOCALE: Record<Locale, string> = {
  en: 'en-us',
  fr: 'fr-fr',
  es: 'es-es',
  zh: 'zh-cn',
  ar: 'en-us',
};

const badge = BADGE_LOCALE[lang];
const label = IS_LIVE ? t('cta.store') : t('hero.cta.primary');

// « Gratuit jusqu'à quatre services, puis 0,49 € la place » — le prix vient du
// fichier StoreKit, pas d'une constante recopiée.
const priceLine = t('cta.price').replace('{price}', formatPrice(PRICES.slot, lang));
---

<div class="store">
  {
    IS_LIVE ? (
      /* Le badge officiel, servi tel qu'Apple le fournit. Le thème choisit la
         variante noire ou blanche — `picture` le fait sans JavaScript. */
      <a class="store-badge" href={STORE_URL}>
        <picture>
          <source srcset={`/badges/white-${badge}.svg`} media="(prefers-color-scheme: dark)" />
          <img src={`/badges/black-${badge}.svg`} alt={label} height="52" />
        </picture>
      </a>
    ) : (
      /* Pas de badge Apple pour une bêta : bouton maison vers TestFlight. */
      <a class="store-btn" href={STORE_URL}>
        <svg class="store-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M17.05 12.54c.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.18-1.72-1.35-.14-2.64.8-3.33.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.51-.71 2.84-.71s1.7.71 2.87.69c1.18-.02 1.93-1.08 2.65-2.14.84-1.23 1.18-2.42 1.2-2.48-.03-.01-2.3-.88-2.32-3.5zM14.88 5.9c.6-.74 1.01-1.75.9-2.77-.87.04-1.93.58-2.56 1.31-.56.65-1.06 1.69-.93 2.68.97.08 1.97-.49 2.59-1.22z"
          />
        </svg>
        <span>{label}</span>
      </a>
    )
  }
  <p class="store-price">{priceLine}</p>
  {secondary && (
    <p class="store-secondary">
      <a href={secondary.href}>{secondary.label} →</a>
    </p>
  )}
</div>

<style>
  .store { margin-block: 30px 0; }

  /* Zone de protection exigée par Apple : au moins un quart de la hauteur du
     badge tout autour, sans autre élément. */
  .store-badge { display: inline-block; padding: 13px 13px 13px 0; }
  .store-badge img { height: 52px; width: auto; display: block; }

  /* Bouton de bêta — pastille qui emprunte l'encre du texte, donc lisible
     dans les deux thèmes. */
  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 26px;
    border-radius: 14px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .store-btn:hover { opacity: 0.88; }
  .store-badge:hover { opacity: 0.88; }

  .store-glyph { width: 22px; height: 22px; flex: none; }

  .store-price {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
    margin: 14px 0 0;
  }

  .store-secondary { margin: 10px 0 0; font-size: 15px; }
  .store-secondary a { text-decoration: none; }
</style>
