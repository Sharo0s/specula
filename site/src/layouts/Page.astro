---
import '../styles/base.css';
import { BCP47, LOCALES, LOCALE_NAMES, dir, useTranslations, type Locale } from '../i18n';
import { TESTFLIGHT } from '../data/links';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Locale;
  /** Chemin sans la langue : '' pour l'accueil, 'integrations/jellyfin/' etc. */
  route?: string;
  title: string;
  description: string;
  /** Section de navigation à marquer comme courante. */
  current?: string;
}

const { lang, route = '', title, description, current } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://specula.dev');
const url = (l: Locale) => new URL(`/${l}/${route}`, site).href;

// La navigation du mockup : Fonctionnement et FAQ mènent aux ancres de
// l'accueil, la vie privée reste au pied de page.
const nav = [
  { key: 'integrations', label: t('nav.integrations'), href: `/${lang}/integrations/` },
  { key: 'how', label: t('nav.how'), href: `/${lang}/#fonctionnement` },
  { key: 'pricing', label: t('nav.pricing'), href: `/${lang}/pricing/` },
  { key: 'faq', label: t('nav.faq'), href: `/${lang}/#faq` },
  { key: 'changelog', label: t('nav.changelog'), href: `/${lang}/changelog/` },
];

---

<!doctype html>
<html lang={BCP47[lang]} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={BCP47[l]} href={url(l)} />)}
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={BCP47[lang]} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Specula — Your homelab in your hand" />
    <meta property="og:site_name" content="Specula" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    {/* Le seul script du site. Il applique le thème choisi avant la première
        peinture (sinon la page clignote), puis écoute les clics du bouton par
        délégation — il n'a donc pas besoin d'attendre le DOM. Toute retouche
        ici oblige à recalculer le hash SHA-256 déclaré dans vercel.json,
        sans quoi la CSP le bloquera en production. */}
    <script is:inline>
      (function () {
        var d = document.documentElement,
          s = localStorage.getItem('theme');
        if (s) d.dataset.theme = s;
        document.addEventListener('click', function (e) {
          var b = e.target.closest('[data-theme-toggle]');
          if (!b) return;
          var dark =
            (d.dataset.theme ||
              (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
          d.dataset.theme = dark ? 'light' : 'dark';
          localStorage.setItem('theme', d.dataset.theme);
          b.setAttribute('aria-pressed', String(!dark));
        });
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <header class="wrap">
      <nav class="nav">
        <a class="brand" href={`/${lang}/`}>
          <img src="/icon-180.png" alt="" width="28" height="28" />
          <span class="brand-name">Specula</span>
        </a>
        <div class="nav-links">
          {
            nav.map((item) => (
              <a class="nav-item" href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={TESTFLIGHT} class="btn-beta" target="_blank" rel="noopener">{t('nav.cta')}</a>
          <button type="button" class="theme" data-theme-toggle aria-label={t('theme.toggle')}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {/* lune et soleil dans le même gabarit : le CSS montre celui qui
                  correspond au thème courant */}
              <path
                class="moon"
                fill="currentColor"
                d="M21 13.2A9 9 0 1 1 10.8 3a7 7 0 0 0 10.2 10.2z"
              />
              <g class="sun" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
              </g>
            </svg>
          </button>
          {/* Menu mobile : un <details> natif — pas de script inline, la CSP
              reste à un seul hash. Il reprend les liens cachés sous 860 px et
              héberge la bascule de thème, remplacée dans la barre par lui. */}
          <details class="burger">
            <summary aria-label={t('nav.menu')}>
              <svg class="ic-burger" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
              <svg class="ic-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </summary>
            <div class="burger-panel">
              {
                nav.map((item) => (
                  <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))
              }
              <button type="button" class="burger-theme" data-theme-toggle>
                {t('theme.toggle')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    class="moon"
                    fill="currentColor"
                    d="M21 13.2A9 9 0 1 1 10.8 3a7 7 0 0 0 10.2 10.2z"
                  />
                  <g class="sun" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
                  </g>
                </svg>
              </button>
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap">
      <div class="footer-grid">
        {/* Le monogramme nysia : encre sombre sur pastille ocre en clair,
            tracé blanc en sombre — le CSS montre celui du thème courant. */}
        <p class="footer-brand">
          <a href="https://nysia.fr" target="_blank" rel="noopener">
            <img class="brand-light" src="/nysia-footer-light.png" alt="" width="26" height="26" />
            <img class="brand-dark" src="/nysia-footer-dark.png" alt="" width="26" height="26" />
            <span>© nysia</span>
          </a>
        </p>
        <p class="footer-links">
          <a href={`/${lang}/support/`}>{t('footer.support')}</a>
          <a href={`/${lang}/privacy/`}>{t('footer.privacy')}</a>
          <a href={`/${lang}/changelog/`}>{t('footer.changelog')}</a>
          <a href="https://github.com/Sharo0s/specula" target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
      <div class="footer-grid footer-under">
        <p class="footer-langs">
          <span class="visually-hidden">{t('footer.language')}</span>
          {
            LOCALES.map((l) => (
              <a href={`/${l}/${route}`} lang={BCP47[l]} aria-current={l === lang ? 'true' : undefined}>
                {LOCALE_NAMES[l]}
              </a>
            ))
          }
        </p>
      </div>
      {/* La marque et la licence du code sont invariantes ; seule la mention
          de la police vient des chaînes. Le © vit à côté du logo, plus haut. */}
      <p class="footer-license">Specula — GPL-3.0. {t('footer.license')}</p>
    </footer>

    {/* Ce script-là est un module empaqueté par Astro (servi depuis /_astro/,
        couvert par script-src 'self') : contrairement au script inline du
        thème, il ne demande aucune empreinte dans la CSP. */}
    <script>
      const header = document.querySelector('header.wrap');
      const onScroll = () => header?.classList.toggle('pill', scrollY > 80);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Le menu mobile se referme quand on suit un lien (une ancre ne
      // recharge pas la page) ou qu'on clique ailleurs.
      const burger = document.querySelector<HTMLDetailsElement>('details.burger');
      document.addEventListener('click', (e) => {
        if (!burger?.open) return;
        const t = e.target as Element;
        if (t.closest('.burger-panel a') || !t.closest('details.burger')) burger.open = false;
      });
    </script>

    <style>
      .theme {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: transparent;
        color: var(--text);
        cursor: pointer;
      }
      .theme:hover { border-color: var(--accent); color: var(--accent); }
      .theme svg { width: 17px; height: 17px; }

      /* En clair on propose la lune, en sombre le soleil : l'icône annonce où
         le clic mène, pas où l'on est. Les deux boutons (barre et menu
         mobile) suivent la même règle. */
      .theme .sun, .burger-theme .sun { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) :is(.theme, .burger-theme) .moon { display: none; }
        :root:not([data-theme='light']) :is(.theme, .burger-theme) .sun { display: inline; }
      }
      :root[data-theme='dark'] :is(.theme, .burger-theme) .moon { display: none; }
      :root[data-theme='dark'] :is(.theme, .burger-theme) .sun { display: inline; }
      :root[data-theme='light'] :is(.theme, .burger-theme) .moon { display: inline; }
      :root[data-theme='light'] :is(.theme, .burger-theme) .sun { display: none; }

      /* — menu mobile : bouton rond comme la bascule de thème, panneau posé
           sous la barre. Invisible au-delà de 860 px, où les liens vivent
           dans la barre. — */
      .burger { position: relative; display: none; }
      .burger summary {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        color: var(--text);
        cursor: pointer;
        list-style: none;
      }
      .burger summary::-webkit-details-marker { display: none; }
      .burger summary:hover { border-color: var(--accent); color: var(--accent); }
      .burger summary svg { width: 17px; height: 17px; }
      .ic-close { display: none; }
      .burger[open] .ic-burger { display: none; }
      .burger[open] .ic-close { display: block; }
      .burger-panel {
        position: absolute;
        top: calc(100% + 14px);
        inset-inline-end: 0;
        z-index: 70;
        min-width: 220px;
        padding: 8px;
        background: var(--bg);
        border: 1px solid var(--rule);
        border-radius: 16px;
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);
      }
      .burger-panel a {
        display: block;
        padding: 11px 14px;
        border-radius: 10px;
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
      }
      .burger-panel a:hover { background: var(--bg-raised); }
      .burger-panel a[aria-current] { color: var(--accent); }
      .burger-theme {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        margin-block-start: 6px;
        padding: 12px 14px;
        border: 0;
        border-block-start: 1px solid var(--rule);
        border-radius: 0 0 10px 10px;
        background: none;
        color: var(--muted);
        font: inherit;
        font-size: 15px;
        cursor: pointer;
      }
      .burger-theme:hover { color: var(--accent); }
      .burger-theme svg { width: 17px; height: 17px; }

      @media (max-width: 860px) {
        .burger { display: block; }
        .theme { display: none; }
      }
      .footer-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 32px;
        justify-content: space-between;
        align-items: center;
      }
      .footer-brand { display: flex; align-items: center; margin: 0; }
      .footer-brand a {
        display: flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        color: var(--muted);
        font-weight: 600;
      }
      .footer-brand a:hover { color: var(--text); }
      .footer-brand img { width: 26px; height: 26px; }
      .brand-light { border-radius: 5px; }

      /* Même mécanique à trois états que la lune et le soleil du bouton de
         thème : préférence système, puis choix explicite dans les deux sens. */
      .brand-dark { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .brand-light { display: none; }
        :root:not([data-theme='light']) .brand-dark { display: block; }
      }
      :root[data-theme='dark'] .brand-light { display: none; }
      :root[data-theme='dark'] .brand-dark { display: block; }
      :root[data-theme='light'] .brand-light { display: block; }
      :root[data-theme='light'] .brand-dark { display: none; }

      .footer-under { margin-block-start: 14px; }
      .footer-links a, .footer-langs a { margin-inline-end: 16px; text-decoration: none; }
      .footer-links a:hover, .footer-langs a:hover { text-decoration: underline; }
      .footer-langs a[aria-current] { color: var(--accent); font-weight: 700; }
      .footer-license { max-width: none; margin-block-start: 18px; font-size: 13px; }
    </style>
  </body>
</html>
