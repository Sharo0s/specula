---
import Page from '../../../layouts/Page.astro';
import { LOCALES, useTranslations, type Locale } from '../../../i18n';
import { metricLabel } from '../../../i18n/metrics';
import { SERVICES, FAMILY_ORDER } from '../../../data/services';
import catalog from '../../../data/integrations.json';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const ISSUE_TEMPLATE = 'https://github.com/Sharo0s/specula/issues/new?template=feature.yml';

const named = catalog.filter((c) => c.slug !== 'generic' && SERVICES[c.slug]);

const groups = FAMILY_ORDER.map((family) => ({
  label: t(`family.${family}` as 'family.media'),
  rows: named
    .filter((c) => SERVICES[c.slug]!.family === family)
    .map((c) => ({
      slug: c.slug,
      name: SERVICES[c.slug]!.name,
      metrics: c.metrics.map((m) => metricLabel(m, lang)),
    }))
    .sort((a, b) => a.name.localeCompare(b.name)),
}));

const title = `${t('integrations.title')} — Specula`;
---

<Page
  {lang}
  route="integrations/"
  {title}
  description={t('integrations.lede')}
  current="integrations"
>
  <section class="wrap section">
    <p class="eyebrow">{t('integrations.eyebrow')}</p>
    <h1>{t('integrations.title')}</h1>
    <p class="lede">{t('integrations.lede')}</p>
  </section>

  <section class="wrap">
    {
      groups.map((group) => (
        <div class="family">
          <h2>{group.label}</h2>
          <ul class="list">
            {group.rows.map((row) => (
              <li>
                <a href={`/${lang}/integrations/${row.slug}/`}>
                  <span class="name">{row.name}</span>
                  {row.metrics.length ? (
                    <span class="metrics">
                      {row.metrics.map((m) => (
                        <i>{m}</i>
                      ))}
                    </span>
                  ) : (
                    <span class="metrics none">{t('integrations.metrics.none')}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="wrap section">
    <hr class="rule-thin" />
    <h2 class="missing">{t('integrations.missing')}</h2>
    <p>{t('integrations.missing.body')}</p>
    {/* le formulaire dédié du dépôt : les issues vierges y sont désactivées,
        c'est donc le seul chemin — autant y mener directement */}
    <p>
      <a class="btn btn-secondary" href={ISSUE_TEMPLATE} target="_blank" rel="noopener">
        {t('integrations.missing.cta')}
      </a>
    </p>
  </section>
</Page>

<style>
  /* Une carte cliquable par service : les métriques deviennent des pastilles,
     ce que la liste en deux colonnes ne montrait qu'en petit texte gris. */
  .family { margin-block-end: 40px; }
  .family h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    margin-block-end: 14px;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }
  .list a {
    display: block;
    height: 100%;
    padding: 16px 18px;
    background: var(--card);
    border: 1px solid var(--shot-border);
    border-radius: 14px;
    text-decoration: none;
    color: var(--text);
  }
  .list a:hover { border-color: var(--accent); }
  .name { display: block; font-weight: 700; font-size: 17px; letter-spacing: -0.015em; }
  .metrics { display: flex; flex-wrap: wrap; gap: 6px; margin-block-start: 12px; }
  .metrics i {
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
    /* Le rouge de marque est assombri de 12% pour ce seul usage : sur du texte
       de 12px, #ec3013 plein ne donne que 4,2:1 contre le blanc, sous le seuil
       AA de 4,5:1. Le mélange monte à ~5:1 sans changer la couleur perçue. */
    background: color-mix(in srgb, var(--accent) 88%, #000);
    color: #fff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 3px 10px;
  }
  .metrics.none { color: var(--muted); font-size: 13px; display: block; }
  .missing { margin-block-start: 24px; }
</style>
