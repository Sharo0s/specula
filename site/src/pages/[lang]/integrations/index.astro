---
import Page from '../../../layouts/Page.astro';
import { LOCALES, useTranslations, type Locale } from '../../../i18n';
import { metricLabel } from '../../../i18n/metrics';
import { SERVICES, FAMILY_ORDER } from '../../../data/services';
import { badgePalette } from '../../../data/palette';
import catalog from '../../../data/integrations.json';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const ISSUE_TEMPLATE = 'https://github.com/Sharo0s/specula/issues/new?template=feature.yml';

const named = catalog.filter((c) => c.slug !== 'generic' && SERVICES[c.slug]);

const groups = FAMILY_ORDER.map((family) => ({
  label: t(`family.${family}` as 'family.media'),
  rows: named
    .filter((c) => SERVICES[c.slug]!.family === family)
    .map((c) => ({
      slug: c.slug,
      name: SERVICES[c.slug]!.name,
      needsKey: c.needsKey,
      metrics: c.metrics.map((m) => metricLabel(m, lang)),
    }))
    .sort((a, b) => a.name.localeCompare(b.name)),
}));

// L'index global d'une carte décide de son monogramme : la palette du mockup
// tourne en boucle sur tout le catalogue.
let badgeIndex = 0;

const title = `${t('integrations.title')} — Specula`;
---

<Page
  {lang}
  route="integrations/"
  {title}
  description={t('integrations.lede')}
  current="integrations"
>
  <section class="wrap section">
    <p class="eyebrow">{t('integrations.eyebrow')}</p>
    <h1>{t('integrations.title')}</h1>
    <p class="lede">{t('integrations.lede')}</p>
  </section>

  <section class="wrap">
    {
      groups.map((group) => (
        <div class="family">
          <h2>{group.label}</h2>
          <ul class="list">
            {group.rows.map((row) => {
              const [color, bg] = badgePalette(badgeIndex++);
              return (
                <li>
                  <a class="cat-card" href={`/${lang}/integrations/${row.slug}/`}>
                    <span class="cat-head">
                      <span class="mono-badge" style={`color:${color};background:${bg}`}>
                        {row.name.charAt(0).toUpperCase()}
                      </span>
                      <span class="name">{row.name}</span>
                      {row.needsKey && <span class="cat-key">{t('integrations.key.chip')}</span>}
                    </span>
                    {row.metrics.length ? (
                      <span class="metrics">
                        {row.metrics.map((m) => (
                          <i>{m}</i>
                        ))}
                      </span>
                    ) : (
                      <span class="metrics none">{t('integrations.metrics.none')}</span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="wrap section">
    <hr class="rule-thin" />
    <h2 class="missing">{t('integrations.missing')}</h2>
    <p>{t('integrations.missing.body')}</p>
    {/* le formulaire dédié du dépôt : les issues vierges y sont désactivées,
        c'est donc le seul chemin — autant y mener directement */}
    <p>
      <a class="btn btn-secondary" href={ISSUE_TEMPLATE} target="_blank" rel="noopener">
        {t('integrations.missing.cta')}
      </a>
    </p>
  </section>
</Page>

<style>
  /* Une carte cliquable par service : les métriques deviennent des pastilles,
     ce que la liste en deux colonnes ne montrait qu'en petit texte gris. */
  .family { margin-block-end: 40px; }
  .family h2 {
    font-family: var(--mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    margin-block-end: 14px;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 18px;
    background: var(--card);
    border: 2px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .cat-card:hover { border-color: var(--rule-strong); transform: translateY(-2px); }
  .cat-head { display: flex; align-items: center; gap: 10px; }
  .mono-badge {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 13.5px;
    font-weight: 700;
    flex: none;
  }
  .name { font-weight: 680; font-size: 15.5px; }
  .cat-key {
    margin-inline-start: auto;
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 3px 9px;
    white-space: nowrap;
  }
  .metrics { display: flex; flex-wrap: wrap; gap: 6px; }
  .metrics i {
    font-style: normal;
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--ok-soft);
    color: var(--ok);
  }
  .metrics.none { color: var(--muted); font-size: 13px; display: block; }
  .missing { margin-block-start: 24px; }
</style>
