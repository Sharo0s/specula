{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/en/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/ph/static/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/:path"
    },
    { "source": "/ph/:path(.*)", "destination": "https://eu.i.posthog.com/:path" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'sha256-kpYfrhPWdOYR6G6eMnKeLlD1gl+SDtm/yhaYQJxTCnw='; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
